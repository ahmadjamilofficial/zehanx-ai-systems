SITE_URL=https://zehanxtech.vercel.app
# Rewind is the only LLM provider for Idea Studio.
# Set REWIND_API_KEY in Vercel Production Environment Variables.
REWIND_API_KEY=
REWIND_BASE_URL=https://api.rewind.ai
REWIND_MODEL=qwen/qwen3.5-9b

# Required for lead persistence. Apply the SQL migration first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional lead notification email via Resend.
RESEND_API_KEY=
LEADS_TO_EMAIL=
LEADS_FROM_EMAIL=
